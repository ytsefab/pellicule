<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- Réglages : flash, minuteur, vignette, grain -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/top_scrim"
        android:orientation="horizontal"
        android:paddingBottom="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout android:id="@+id/btnFlash" style="@style/TopButton">
            <ImageView android:id="@+id/icFlash" style="@style/TopButtonIcon" android:src="@drawable/ic_flash_off" />
            <TextView android:id="@+id/lblFlash" style="@style/TopButtonLabel" android:text="@string/flash_off" />
        </LinearLayout>

        <LinearLayout android:id="@+id/btnTimer" style="@style/TopButton">
            <ImageView android:id="@+id/icTimer" style="@style/TopButtonIcon" android:src="@drawable/ic_timer" />
            <TextView android:id="@+id/lblTimer" style="@style/TopButtonLabel" android:text="@string/timer_off" />
        </LinearLayout>

        <LinearLayout android:id="@+id/btnVignette" style="@style/TopButton">
            <ImageView android:id="@+id/icVignette" style="@style/TopButtonIcon" android:src="@drawable/ic_vignette" />
            <TextView android:id="@+id/lblVignette" style="@style/TopButtonLabel" android:text="@string/vignette" />
        </LinearLayout>

        <LinearLayout android:id="@+id/btnGrain" style="@style/TopButton">
            <ImageView android:id="@+id/icGrain" style="@style/TopButtonIcon" android:src="@drawable/ic_grain" />
            <TextView android:id="@+id/lblGrain" style="@style/TopButtonLabel" android:text="@string/grain" />
        </LinearLayout>

        <LinearLayout android:id="@+id/btnBlur" style="@style/TopButton">
            <ImageView android:id="@+id/icBlur" style="@style/TopButtonIcon" android:src="@drawable/ic_blur" />
            <TextView android:id="@+id/lblBlur" style="@style/TopButtonLabel" android:text="@string/blur_off" />
        </LinearLayout>

        <LinearLayout android:id="@+id/btnFormat" style="@style/TopButton">
            <ImageView android:id="@+id/icFormat" style="@style/TopButtonIcon" android:src="@drawable/ic_format" />
            <TextView android:id="@+id/lblFormat" style="@style/TopButtonLabel" android:text="4:3" />
        </LinearLayout>
    </LinearLayout>

    <!-- Aperçu au format choisi (taille réglée dans le code), même cadrage que la photo enregistrée -->
    <FrameLayout
        android:id="@+id/previewFrame"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/surface"
        app:layout_constraintDimensionRatio="H,3:4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <androidx.camera.view.PreviewView
            android:id="@+id/previewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.pellicule.app.BlurView
            android:id="@+id/blurView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.pellicule.app.VignetteView
            android:id="@+id/vignetteView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.pellicule.app.GrainView
            android:id="@+id/grainView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <View
            android:id="@+id/blinkOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"
            android:background="@android:color/black" />

        <View
            android:id="@+id/touchLayer"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <View
            android:id="@+id/focusRing"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:alpha="0"
            android:background="@drawable/focus_ring" />

        <LinearLayout
            android:id="@+id/titleBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:alpha="0"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/filterTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:shadowColor="#99000000"
                android:shadowDy="2"
                android:shadowRadius="14"
                android:textColor="@color/ink"
                android:textSize="40sp"
                android:textStyle="italic" />

            <TextView
                android:id="@+id/filterIndex"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.2"
                android:shadowColor="#99000000"
                android:shadowRadius="8"
                android:textColor="@color/accent"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/countdownText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="serif"
            android:shadowColor="#99000000"
            android:shadowRadius="20"
            android:textColor="@color/ink"
            android:textSize="120sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/permissionPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/surface"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:lineSpacingMultiplier="1.25"
                android:text="@string/permission_message"
                android:textColor="@color/ink"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/permissionButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/pill_accent"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="22dp"
                android:paddingTop="12dp"
                android:paddingEnd="22dp"
                android:paddingBottom="12dp"
                android:text="@string/permission_button"
                android:textColor="@color/bg"
                android:textSize="15sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Bande de filtres + déclencheur. Passe par-dessus l'aperçu sur les écrans courts. -->
    <LinearLayout
        android:id="@+id/bottomPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bottom_scrim"
        android:orientation="vertical"
        android:paddingTop="22dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Intensité du flou, visible seulement quand le flou est activé -->
        <!-- clickable : un doigt posé à côté du curseur ne change pas de filtre par erreur -->
        <LinearLayout
            android:id="@+id/blurRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="6dp"
            android:visibility="gone">

            <TextView style="@style/SliderLabel" android:text="@string/blur_light" />

            <SeekBar
                android:id="@+id/blurSeek"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:contentDescription="@string/cd_blur_strength"
                android:max="100"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:progressBackgroundTint="@color/ink_dim"
                android:progressTint="@color/accent"
                android:thumbTint="@color/accent" />

            <TextView style="@style/SliderLabel" android:text="@string/blur_strong" />
        </LinearLayout>

        <HorizontalScrollView
            android:id="@+id/filterScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/filterStrip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp" />
        </HorizontalScrollView>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="100dp">

            <ImageView
                android:id="@+id/galleryThumb"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="40dp"
                android:background="@drawable/gallery_bg"
                android:contentDescription="@string/cd_gallery"
                android:scaleType="center"
                android:src="@drawable/ic_gallery" />

            <View
                android:id="@+id/shutter"
                android:layout_width="78dp"
                android:layout_height="78dp"
                android:layout_gravity="center"
                android:background="@drawable/shutter"
                android:clickable="true"
                android:contentDescription="@string/cd_shutter"
                android:focusable="true" />

            <ImageView
                android:id="@+id/switchButton"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="40dp"
                android:background="@drawable/round_button"
                android:contentDescription="@string/cd_switch"
                android:scaleType="center"
                android:src="@drawable/ic_switch" />
        </FrameLayout>
    </LinearLayout>

    <!-- Flash écran pour la caméra frontale -->
    <View
        android:id="@+id/screenFlash"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#FFFFF8EE"
        android:elevation="20dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
